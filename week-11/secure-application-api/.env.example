# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.
#
# Two separate databases, so the vulnerable app and the fixed app can run side
# by side without touching each other's data.
VULNERABLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_app_vulnerable
SECURE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_app_secure

# Used by the secure version only: the key that signs its JWTs.
# Generate with: bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())'
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-characters

# Used by the secure version only: the one origin allowed to call it (CORS).
ALLOWED_ORIGIN=http://localhost:5173
