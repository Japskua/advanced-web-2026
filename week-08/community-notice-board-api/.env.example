# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/notice_board

# Generate with: bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())'
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-characters

# The first administrator, created by `bun run seed:admin`.
# The password must satisfy the same policy as every other password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
