# Copy to .env. Values starting with BUN_PUBLIC_ are written INTO the browser
# bundle at build time, so they must never be secrets: anyone can read them.

# Local development: the API from week-12/encrypted-file-vault-api.
# Production: week-12/deploy/prepare.ts sets it to the site's own address
# while building (Caddy serves the client and routes /api to the API), e.g.
#   BUN_PUBLIC_API_URL=https://vault.203-0-113-10.sslip.io bun run build
BUN_PUBLIC_API_URL=http://localhost:8000
