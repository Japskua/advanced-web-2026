# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.
# On the server, the deployment's own .env provides these (see week-12/deploy).

PORT=8000

# Local: the PostgreSQL container from the repository's docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/file_vault

# Generate with: bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())'
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-characters

# Registration requires this code, so strangers cannot sign up to your deployment.
INVITE_CODE=AWA2026

# The origin of the client. Local: the Bun dev server. Production: the site's URL.
ALLOWED_ORIGIN=http://localhost:5173

# Only behind a reverse proxy that sets X-Forwarded-For (Caddy in production).
# Leave unset locally.
# TRUST_PROXY=true

# S3-compatible object storage. Locally: SeaweedFS from docker-compose.yml, with
# the development credentials set there. In production: SeaweedFS on your own
# server, or a provider, e.g.
#   Hetzner Object Storage: S3_ENDPOINT=https://fsn1.your-objectstorage.com
#                           S3_REGION=fsn1  S3_VIRTUAL_HOSTED_STYLE=true
#   DigitalOcean Spaces:    S3_ENDPOINT=https://fra1.digitaloceanspaces.com
#                           S3_REGION=us-east-1  S3_VIRTUAL_HOSTED_STYLE=true
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=encrypted-files
S3_ACCESS_KEY_ID=awa-dev-access-key
S3_SECRET_ACCESS_KEY=awa-dev-secret-key
S3_REGION=us-east-1
# S3_VIRTUAL_HOSTED_STYLE=true
