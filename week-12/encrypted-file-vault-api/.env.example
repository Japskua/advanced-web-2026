# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.
# In Azure, the same variables are set on the Container App (see the README).

PORT=8000

# Local: the PostgreSQL container from docker-compose.yml.
# Azure: postgres://<admin>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/file_vault

# Generate with: bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())'
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-characters

# Registration requires this code, so strangers cannot sign up to your deployment.
INVITE_CODE=AWA2026

# The origin of the client. Local: the Bun dev server. Azure: the Static Web App URL.
ALLOWED_ORIGIN=http://localhost:5173

# Azure only: the API runs behind the Container Apps ingress, which passes the
# client's IP address in X-Forwarded-For. Leave unset locally.
# TRUST_PROXY=true

# Local: Azurite, the storage emulator from docker-compose.yml.
# Azure: Storage account → Security + networking → Access keys → Connection string.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER_NAME=encrypted-files
