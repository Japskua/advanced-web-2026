# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.

# Where this API runs. The OAuth callback URL is built from it:
#   ${BASE_URL}/auth/google/callback
# and must be registered exactly like that in Google Cloud Console.
BASE_URL=http://localhost:8000

# Where the React client runs. Used for redirects after login and for CORS.
FRONTEND_URL=http://localhost:5173

# From Google Cloud Console → APIs & Services → Credentials (see the README).
GOOGLE_CLIENT_ID=TODO_AFTER_GCP_CONFIGURATION
GOOGLE_CLIENT_SECRET=TODO_AFTER_GCP_CONFIGURATION

# Optional: use another OpenID Connect provider instead of Google.
# To develop without a Google account, start the mock provider in another
# terminal (`bun run mock-oidc`) and uncomment this line. The mock accepts any
# client id and secret.
# OIDC_ISSUER=http://localhost:9000
