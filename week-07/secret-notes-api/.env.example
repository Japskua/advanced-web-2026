# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/secret_notes

# The key that signs and verifies the JWTs. Anyone who knows it can create a
# valid token for any user, so in a real deployment it must be long, random and
# secret. Generate one with:
#   bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())'
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-characters
