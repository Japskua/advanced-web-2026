{
  "name": "advanced-web-2026",
  "private": true,
  "type": "module",
  "workspaces": [
    "week-*/*-api",
    "week-*/*-client",
    "week-*/habit-tracker",
    "week-*/book-explorer"
  ],
  "scripts": {
    "setup:env": "bun scripts/setup-env.ts",
    "setup:db": "bun run --filter \"*\" db:setup",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun run --filter \"*\" test",
    "build": "bun run --filter \"*\" build",
    "lint": "bun --bun eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
