# Copy this file to .env (`cp .env.example .env`). Bun loads .env automatically.
# .env is git-ignored: it is where real passwords go in real projects.

# postgres://<user>:<password>@<host>:<port>/<database>
# These values match the PostgreSQL container in the repository's docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/image_gallery
